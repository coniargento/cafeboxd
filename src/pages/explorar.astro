---
import '../styles/global.css';
import '../styles/fonts.css';

import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';

// fallback local
import raw from '../data/cafes.json';
const FALLBACK = raw;

// FILAS REALES, basadas en tus categorías JSON
const rows = [
  {
    id: 'popular-week',
    title: 'Popular esta semana',
    subtitle: 'Lo que más se está tomando estos días.',
    category: 'popular_week'
  },
  {
    id: 'top-rated',
    title: 'Mejor calificación',
    subtitle: 'Los cafés mejor valorados por la comunidad.',
    category: 'top_rated'
  },
  {
    id: 'brunch',
    title: 'Brunch y café',
    subtitle: 'Ideales para almorzar rico.',
    category: 'brunch'
  },
  {
    id: 'study-work',
    title: 'Para estudiar o trabajar',
    subtitle: 'WiFi, enchufes y ambiente tranquilo.',
    category: 'study_work'
  },
  {
    id: 'pastry',
    title: 'Pastelería destacada',
    subtitle: 'Para fans de lo dulce.',
    category: 'dessert'
  }
];
---

<Layout>
  <SiteHeader activePage="/explorar" />

  <main class="mx-auto max-w-6xl px-4 py-10 space-y-10">
    <section class="space-y-2">
      <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">Explorar cafeterías</h1>
      <p class="text-sm md:text-base text-zinc-400 max-w-2xl">
        Descubrí tendencias y spots nuevos según la experiencia que buscás.
      </p>
    </section>

    <!-- Datos JSON embebidos -->
    <script id="rows-data" type="application/json" set:html={JSON.stringify(rows)}></script>
    <script id="fallback-data" type="application/json" set:html={JSON.stringify(FALLBACK)}></script>

    {rows.map((row) => (
      <section id={row.id} class="relative space-y-3">
        <div class="flex items-baseline justify-between gap-3">
          <div>
            <h2 class="text-lg md:text-xl font-semibold">
              {row.title}
            </h2>
            {row.subtitle && (
              <p class="text-xs md:text-sm text-zinc-400">{row.subtitle}</p>
            )}
          </div>

          <span id={`status-${row.id}`} class="text-[11px] md:text-xs text-zinc-500">
            Cargando...
          </span>
        </div>

        <div class="relative">
          <!-- Flecha izquierda -->
          <button
            type="button"
            class="row-arrow left-0 absolute top-1/2 -translate-y-1/2 -translate-x-1/2 z-10 hidden md:flex items-center justify-center rounded-full bg-black/80 border border-zinc-700 text-zinc-200 hover:bg-zinc-800 hover:border-zinc-500 h-8 w-8"
            data-row={row.id}
            data-dir="left"
          >
            ‹
          </button>

          <!-- Contenedor scroll -->
          <div
            class="row-scroll flex gap-3 md:gap-4 overflow-x-auto scrollbar-thin scrollbar-thumb-zinc-700 scrollbar-track-zinc-900 snap-x snap-mandatory pb-1"
            data-row-scroll={row.id}
          ></div>

          <!-- Flecha derecha -->
          <button
            type="button"
            class="row-arrow right-0 absolute top-1/2 translate-y-0 translate-x-1/2 z-10 hidden md:flex items-center justify-center rounded-full bg-black/80 border border-zinc-700 text-zinc-200 hover:bg-zinc-800 hover:border-zinc-500 h-8 w-8"
            data-row={row.id}
            data-dir="right"
          >
            ›
          </button>
        </div>
      </section>
    ))}
  </main>

  <script type="module">
    const ROWS = JSON.parse(document.getElementById('rows-data').textContent);
    const FALLBACK = JSON.parse(document.getElementById('fallback-data').textContent);

    // Filtrar cafés según la categoría del JSON
    function filterByCategory(category) {
      return FALLBACK.filter((c) => c.category === category);
    }

    // Render de cada fila
    function renderRow(rowId, cafes) {
      const container = document.querySelector(`[data-row-scroll="${rowId}"]`);
      if (!container) return;

      container.innerHTML = cafes
        .map(
          (c) => `
          <a href="/cafe/${c.place_id}" class="group relative flex-shrink-0 snap-start w-40 md:w-48">
            <div class="rounded-xl overflow-hidden border border-zinc-800 bg-zinc-950 group-hover:border-zinc-500 transition-all">
              <div class="aspect-[3/4] bg-cover bg-center" style="background-image:url('${c.thumbnail}')"></div>
              <div class="p-2.5">
                <h3 class="text-[11px] md:text-xs font-semibold text-white line-clamp-2">${c.title}</h3>
                <div class="mt-1 flex items-center gap-1.5 text-[10px] md:text-[11px] text-zinc-400">
                  <span>${c.address.split(',')[1] || ''}</span>
                  <span>·</span>
                  <span>★ ${c.rating.toFixed(1)}</span>
                </div>
              </div>
            </div>
          </a>
        `
        )
        .join('');
    }

    // Cargar cada fila usando SOLO datos locales
    function loadRows() {
      ROWS.forEach((row) => {
        const status = document.getElementById(`status-${row.id}`);
        const items = filterByCategory(row.category);

        if (items.length > 0) {
          renderRow(row.id, items);
          status.textContent = `${items.length} lugares`;
        } else {
          renderRow(row.id, FALLBACK);
          status.textContent = "Sin categoría — mostrando todos";
        }
      });
    }

    // Configurar flechas
    function setupArrows() {
      document.querySelectorAll('.row-arrow').forEach((btn) => {
        const rowId = btn.dataset.row;
        const dir = btn.dataset.dir;
        const container = document.querySelector(`[data-row-scroll="${rowId}"]`);

        btn.addEventListener('click', () => {
          const delta = container.clientWidth * 0.8;
          container.scrollBy({
            left: dir === 'left' ? -delta : delta,
            behavior: 'smooth',
          });
        });
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
      loadRows();
      setupArrows();
    });
  </script>
</Layout>

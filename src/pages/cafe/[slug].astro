---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import raw from '../../data/cafes.json';
import { toCafesFromSerpRaw } from '../../lib/normalize';

const base = (raw as any).default ?? (raw as any);
const items = toCafesFromSerpRaw(base);

export async function getStaticPaths() {
  return items.map((c) => ({
    params: { slug: c.slug },
    props: { cafe: c },
  }));
}

const { cafe } = Astro.props as { cafe: import('../../lib/normalize').Cafe };
const { slug } = Astro.params;
---

<Layout>
  <SiteHeader />

  <div class="mx-auto max-w-5xl px-4 py-6">
    {cafe ? (
      <>
        <a href="/" class="text-sm text-zinc-400 hover:text-zinc-200">&larr; Volver</a>

        <div class="mt-4 rounded-2xl overflow-hidden border border-zinc-800 bg-zinc-950">
          <div
            class="aspect-[16/9] bg-center bg-cover"
            style={`background-image: url(${cafe.image || '/cafes/fallback.jpg'})`}
            aria-label={cafe.name}
          />
        </div>

        <h1 class="mt-6 text-3xl font-semibold">{cafe.name}</h1>
        <p class="text-zinc-400">{cafe.city}</p>
        <div class="mt-2 inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-black/70 px-3 py-1 text-sm">
          <span>★ {typeof cafe.rating === 'number' ? cafe.rating.toFixed(1) : '-'}</span>
        </div>

        <div class="mt-8 grid gap-6 md:grid-cols-3">
          <div class="md:col-span-2 space-y-4">
            <h2 class="text-xl font-semibold">Reseñas</h2>
            <p class="text-zinc-400">Próximamente: sistema de reseñas locales.</p>
          </div>
          <aside class="space-y-4">
            <h3 class="text-lg font-semibold">Información</h3>
            <ul class="text-zinc-300 text-sm space-y-1">
              {cafe.city && <li><strong>Ciudad:</strong> {cafe.city}</li>}
              {typeof cafe.rating === 'number' && <li><strong>Rating:</strong> {cafe.rating.toFixed(1)}</li>}
              <li><strong>Slug:</strong> {slug}</li>
            </ul>
          </aside>
        </div>
      </>
    ) : (
      <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-6">
        <h1 class="text-2xl font-semibold">Cafetería no encontrada</h1>
        <p class="text-zinc-400 mt-2">Volvé al listado para explorar otras opciones.</p>
      </div>
    )}
  </div>
</Layout>


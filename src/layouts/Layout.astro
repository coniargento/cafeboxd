---
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/fonts.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="../../public/cafes/logocafe.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Descubre las mejores cafeterías de Buenos Aires. Cada taza cuenta una historia." />
		<meta name="keywords" content="café, cafeterías, Buenos Aires, especialidad, baristas" />
		<title>Cafeboxd - Las mejores cafeterías de Buenos Aires</title>
	</head>
	
	<body class="min-h-screen bg-white dark:bg-black text-zinc-900 dark:text-zinc-100">
		<slot />

		<!-- FOOTER -->
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
		scroll-behavior: smooth;
	}
	
	* {
		box-sizing: border-box;
	}

	body {
		font-display: swap;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
</style>

